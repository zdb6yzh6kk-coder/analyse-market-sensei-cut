{
  "app_name": "Analyse Market Sensei Cut",
  "auth": {
    "enabled": true,
    "allow_registration": true,
    "require_allowed_emails_in_cloud": true,
    "require_email_verification": true,
    "allowed_emails": [],
    "verification_code_minutes": 30,
    "password_reset_code_minutes": 15,
    "database_path": "data/auth.duckdb",
    "two_factor": {
      "enabled": true,
      "method": "email_code",
      "code_minutes": 10,
      "required_for_login": true,
      "local_display_code": true
    },
    "rate_limit": {
      "enabled": true,
      "window_minutes": 15,
      "password_max_failures": 5,
      "two_factor_max_failures": 5,
      "verification_max_failures": 5,
      "registration_max_attempts": 3,
      "two_factor_send_max_attempts": 3,
      "password_reset_send_max_attempts": 3,
      "password_reset_max_failures": 5
    },
    "passkeys": {
      "prepared": true,
      "enabled": false,
      "note": "Passkey/WebAuthn ist vorbereitet, aber noch nicht aktiv. Aktivierung erfordert eine WebAuthn-Komponente und feste HTTPS-Domain."
    }
  },
  "security": {
    "require_password_for_sensitive_settings": true,
    "settings_password_gate": true,
    "updates_password_gate": true,
    "ports_and_integrations_password_gate": true,
    "store_api_keys_in_config": false,
    "sensitive_unlock_minutes": 15,
    "note": "Settings, Updates, Ports und API-Platzhalter sind nach Login zusaetzlich per Passwort-Gate geschuetzt."
  },
  "online_operations": {
    "cloud_updates_disabled": true,
    "local_shell_disabled_in_cloud": true,
    "secrets_visible_values": false,
    "required_cloud_secrets": [
      "APP_ENV",
      "APP_PASSWORD",
      "AUTH_ALLOWED_EMAILS",
      "SMTP_HOST",
      "SMTP_PORT",
      "SMTP_USERNAME",
      "SMTP_PASSWORD",
      "SMTP_FROM"
    ],
    "optional_cloud_secrets": [
      "SMTP_USE_TLS",
      "ALPHA_VANTAGE_API_KEY"
    ],
    "backup_schema": "analyse_market_sensei_cut_cloud_backup_v1",
    "monitoring_log": "logs/online_ops.jsonl",
    "deploy_routine": [
      "./scripts/check_project.sh",
      "./scripts/security_check.sh",
      "APP_ENV=cloud APP_PASSWORD=test python scripts/smoke_app.py",
      "./scripts/prepare_cloud_deploy.sh"
    ],
    "description": "Betriebsschicht fuer Streamlit Cloud: saubere Secrets, Monitoring, JSON-Backup fuer Konfig/Watchlists und einfache Deploy-Pruefung."
  },
  "ports_and_integrations": {
    "protected": true,
    "execute_api_calls": false,
    "streamlit_port": 8501,
    "local_api_port": "",
    "webhook_port": "",
    "protected_links": [
      {
        "enabled": false,
        "name": "Beispiel Dashboard",
        "url": "https://example.com",
        "category": "seite",
        "note": "Hier spaeter Link eintragen"
      }
    ],
    "protected_apis": [
      {
        "enabled": false,
        "name": "Beispiel API",
        "base_url": "https://api.example.com",
        "port": "",
        "path": "/v1/status",
        "method": "GET",
        "auth_type": "api_key",
        "api_key_secret_ref": "EXAMPLE_API_KEY",
        "note": "Secret-Wert in Streamlit Secrets oder ENV ablegen"
      }
    ]
  },
  "ui": {
    "style_reference": "TradingView-artige Analyseoberflaeche, ohne Marken-Kopie",
    "system_alert_color": "#ff2bd6",
    "system_alert_meaning": "Pink markiert System-Erkennung, Speicherung, Breakout-Watch und Bot-Vorbereitung. Keine Orders."
  },
  "runtime_mode": {
    "active": "papertrading",
    "available": [
      "papertrading",
      "real"
    ],
    "orders_enabled": false,
    "broker_enabled": false,
    "description": "Vorbereiteter Modus-Schalter. Es werden keine Orders ausgefuehrt."
  },
  "broker_planning": {
    "enabled": true,
    "execution_enabled": false,
    "api_calls_enabled": false,
    "live_connection_enabled": false,
    "default_provider": "Interactive Brokers",
    "preferred_providers": [
      "Interactive Brokers",
      "Alpaca",
      "Tradier",
      "Saxo",
      "Kraken",
      "Coinbase Advanced",
      "Binance",
      "IG"
    ],
    "description": "Provider-Matrix fuer spaetere Anbindung. Heute nur Planung, Journal und Sicherheitsstatus."
  },
  "trading_safety": {
    "enabled": true,
    "live_trading_enabled": false,
    "sandbox_required": true,
    "paper_api_first": true,
    "order_preview_required": true,
    "two_click_confirmation_required": true,
    "hard_approval_required": true,
    "automatic_orders_allowed": false,
    "kill_switch_active": true,
    "daily_loss_limit_enabled": true,
    "daily_loss_limit_pct": 1.0,
    "daily_loss_limit_amount": 0.0,
    "audit_log_enabled": true,
    "audit_log_path": "logs/trading_safety_audit.jsonl",
    "default_connection_mode": "sandbox_paper",
    "allowed_connection_modes": [
      "sandbox_paper"
    ],
    "description": "Sicherheits-Gate fuer spaetere Broker-Anbindung. Live-Ausfuehrung bleibt aus, bis Sandbox, Vorschau, 2-Klick-Freigabe, Limits und Audit-Log hart erfuellt sind."
  },
  "tracking": {
    "database_path": "data/portfolio_tracker.duckdb",
    "default_quantity": 1.0,
    "paper_enabled": true,
    "real_money_enabled": true,
    "setup_categories": [
      "Trendfolge",
      "Breakout",
      "Pullback",
      "Mean Reversion",
      "Relative Staerke",
      "Defensiv Beobachtung",
      "Sonstiges"
    ],
    "rule_violation_options": [
      "Score unter Mindestwert",
      "Risk State BLOCKED ignoriert",
      "Trend gegen Richtung",
      "Close unter EMA200",
      "Stop fehlt",
      "Ziel fehlt",
      "Positionsgroesse zu hoch",
      "Marktampel nicht OK",
      "Keine klare These"
    ],
    "description": "Manuelles Tracking fuer Papertrading und Real Money. Keine Orders, keine Broker-Anbindung."
  },
  "workspace": {
    "database_path": "data/workspace.duckdb",
    "default_focus": "Schnellblick",
    "energy_mode": "manual_cache",
    "categories": [
      "Markt",
        "Watchlist",
        "Paper",
        "Real",
        "Research",
        "Screens"
      ],
    "data_collection": {
      "manual_button": true,
      "auto_collect_on_analysis": false,
      "load_on_start": true,
      "reports_only_on_button": true,
      "snapshots_only_on_analysis": true,
      "background_jobs_cloud": false,
      "background_jobs_local": true
    },
    "description": "Vereinfachter TradingView-artiger Workspace fuer Schnellzugriff, gespeicherte Themen und Datensammlung."
  },
  "risk_management": {
    "mode": "rules_only",
    "principles": [
      "Keine Orders",
      "Keine Broker-Funktion",
      "Keine Gefuehlsentscheidungen",
      "Nur harte Regeln"
    ],
    "thresholds": {
      "blocked_score_below": 40,
      "reduced_score_below": 60
    },
    "limits": {
      "standard_risk_per_signal_pct": 0.5,
      "reduced_risk_per_signal_pct": 0.25,
      "standard_position_size_pct": 5.0,
      "reduced_position_size_pct": 2.5,
      "technical_stop_distance_pct": 3.0,
      "portfolio_daily_loss_limit_pct": 1.0,
      "portfolio_weekly_loss_limit_pct": 3.0,
      "max_correlation_group_pct": 20.0
    },
    "hard_rules": [
      "BLOCKED wenn Score unter 40",
      "BLOCKED wenn Symbol bearish",
      "BLOCKED wenn Close unter EMA200",
      "BLOCKED wenn SPY und QQQ bearish",
      "REDUCED wenn Score unter 60",
      "REDUCED wenn Close unter EMA20 oder EMA50",
      "REDUCED wenn relative Staerke gegen QQQ negativ",
      "REDUCED wenn SPY und QQQ nicht gleiche Richtung haben"
    ]
  },
  "data": {
    "timeframes": [
      "1d",
      "1wk",
      "1mo"
    ],
    "periods": {
      "1d": "2y",
      "1wk": "10y",
      "1mo": "20y"
